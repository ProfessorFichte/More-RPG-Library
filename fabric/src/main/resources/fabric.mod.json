{
	"schemaVersion": 1,
	"id": "mrpg_lib",
	"version": "${version}",
	"name": "More RPG Library",
	"description": "A general-purpose library for all my RPG themed content mods.",
	"authors": ["Fichte"
	],
	"contact": {
		"sources": "https://github.com/ProfessorFichte/More-RPG-Classes"
	},
	"contributors": [
		"Rulft44 (Leaf particle & Nature Rune)"
	],
	"license": "MIT",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"com.mrpg_lib.fabric.client.FabricClient"
		],
		"main": [
          "com.mrpg_lib.fabric.FabricMod"
		],
		"fabric-datagen": [
			"com.mrpg_lib.datagen.MrpgDatagen"
		]
	},
	"mixins": [
		"mrpg_lib.mixins.json",
		"mrpg_lib.spell_engine.mixins.json",
		"mrpg_lib.spell_power.mixins.json",
		"mrpg_lib.player_animator.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_compat_version}",
		"fabric-api": "*",
		"minecraft": ">=${minecraft_compat_version}",
		"java": ">=17"
	},
	"suggests": {
		"spell_engine": ">=${spell_engine_version}",
		"spell_power": ">=${spell_power_version}",
		"playeranimator": ">=${player_anim_version}",
		"bettercombat": "*",
		"combat_roll": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/AShKd5XrTu"
			}
		}
	}
}